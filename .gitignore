# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets are gitignored; the example template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Android TWA — signing keys, local Bubblewrap config, and build artifacts
# must never enter the repo. The real keystore is generated outside this
# directory entirely (see android-twa/README.md); these rules are
# defense-in-depth in case a future session or manual step ever points a
# tool at a path inside the repo by mistake.
*.jks
*.keystore
*.p12
*.apk
*.aab
android-twa/twa-manifest.json
android-twa/*.jks
android-twa/*.keystore

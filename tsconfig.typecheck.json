{
  // Used only by `npm run typecheck` (bare tsc), NOT by `next dev`/`next build`.
  //
  // Next.js pins both `.next/types/**` and `.next/dev/types/**` into
  // tsconfig.json's `include` (it re-adds them if removed), but its own
  // build-time typecheck deliberately FILTERS OUT `.next/dev/types` files —
  // see node_modules/next/dist/lib/typescript/runTypeCheck.js — because the
  // dev server's generated types can be stale (deleted routes) or corrupt
  // (interrupted mid-write → "TS1434: Unexpected keyword or identifier" in
  // .next/dev/types/validator.ts). A bare `tsc --noEmit` on tsconfig.json
  // has no such filter, so this config replicates it: same settings, minus
  // the volatile dev-server output. Route types are still checked via
  // `.next/types`, freshly generated by `next typegen` in the typecheck
  // script.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", ".next/dev"]
}

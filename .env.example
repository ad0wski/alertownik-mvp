# Alertownik — Environment Variables Example
#
# Copy this file to .env.local for local development and fill in the real values.
# .env.local is gitignored and must never be committed.
#
# For production, add these variables in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
# Get the values from your Supabase project:
#   dashboard → Settings → API
#
# See docs/SUPABASE_SETUP_CHECKLIST.md for the full setup process.

# ── Supabase ──────────────────────────────────────────────────────────────────

# Your Supabase project URL (safe to expose — not a secret)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (safe for client-side reads with RLS enabled)
# WARNING: RLS must be configured correctly before exposing this key in production
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Keys that must NEVER appear in this file or any committed file ─────────────
#
# SUPABASE_SERVICE_ROLE_KEY  — bypasses all RLS; server-side only
# Database password          — direct Postgres access
#
# If either is accidentally committed, rotate it immediately in the Supabase dashboard.
